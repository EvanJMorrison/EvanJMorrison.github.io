---
layout: default
---
{% assign cover_link = page.amazon_url | default: page.read_url %}
<div class="post book-review">
  <header class="post-header">
    <a class="text-link" href="{{ '/books/' | relative_url }}">All books</a>
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="book-author">
      {{ page.author -}}
      {%- if page.released %} · {{ page.released }}{% endif %}
    </p>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
    <p class="post-meta">
      {% if page.status %}{{ page.status | capitalize }}{% endif %}
      {% if page.stars %} · {{ page.stars }} / 5{% endif %}
      {% if page.reviewed %} · Reviewed {{ page.reviewed | date: '%B %Y' }}{% endif %}
      {% if page.finished %} · Finished {{ page.finished | date: '%B %Y' }}{% endif %}
    </p>
  </header>
  <article class="post-content">
    {% if page.cover or page.olid or page.isbn %}
      <figure class="review-cover">
        {% if cover_link -%}
          <a
            href="{{ cover_link | escape }}"
            rel="external noopener"
            target="_blank"
            aria-label="{% if page.amazon_url %}View {{ page.title | escape }} on Amazon{% else %}Read {{ page.title | escape }} online{% endif %} (opens in a new tab)"
          >
        {%- endif %}
        {% include book-cover.liquid book=page %}
        {% if cover_link %}</a>{% endif %}
      </figure>
    {% endif %}
    {{ content }}
    {% if page.read_url %}
      <p>
        <a class="text-link" href="{{ page.read_url | escape }}" rel="external noopener" target="_blank"
          >Read the full book online<span class="sr-only"> (opens in a new tab)</span></a
        >
      </p>
    {% endif %}
    {% if page.amazon_url %}
      <p>
        <a class="text-link" href="{{ page.amazon_url | escape }}" rel="external noopener" target="_blank"
          >View on Amazon<span class="sr-only"> (opens in a new tab)</span></a
        >
      </p>
    {% endif %}
  </article>
  {% if site.giscus and page.giscus_comments %}{% include giscus.liquid %}{% endif %}
</div>
