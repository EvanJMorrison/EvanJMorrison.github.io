---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.alt
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    {% if page.latest_posts and page.latest_posts.enabled %}
      <section class="home-blog" aria-labelledby="home-blog-title">
        <p class="eyebrow">Writing & reflection</p>
        <h2 id="home-blog-title"><a href="{{ '/blog/' | relative_url }}">Blog</a></h2>
        <p>Essays on science, philosophy, and the ideas I’m thinking through.</p>
        {% if site.posts.size > 0 %}
          {% for post in site.posts limit: 3 %}
            <article class="home-blog-entry">
              <p class="post-meta">{% include display-date.liquid item=post %}</p>
              <h3>
                <a href="{{ post.url | relative_url }}">{{ post.title }}</a>
              </h3>
              {% if post.description %}
                <p>{{ post.description }}</p>
              {% endif %}
            </article>
          {% endfor %}
          <a class="text-link" href="{{ '/blog/' | relative_url }}">All blog posts</a>
        {% else %}
          <p class="post-meta">My first essay is still to come. In the meantime, explore my book reviews.</p>
          <div class="profile-actions">
            <a class="site-button" href="{{ '/blog/' | relative_url }}">Visit the blog</a>
            <a class="text-link" href="{{ '/books/' | relative_url }}">Read my book reviews</a>
          </div>
        {% endif %}
      </section>
    {% endif %}

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">News</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    {% assign recent_books = site.books | where_exp: 'book', 'book.published != false' | sort: 'date' | reverse %}
    {% if recent_books.size > 0 %}
      <section aria-labelledby="recent-reading-title">
        <h2 id="recent-reading-title"><a href="{{ '/books/' | relative_url }}" style="color: inherit">Recent reading</a></h2>
        {% for book in recent_books limit: 1 %}
          <article class="book-entry{% unless book.cover or book.olid or book.isbn %} without-cover{% endunless %}">
            {% if book.cover or book.olid or book.isbn -%}
              <a href="{{ book.url | relative_url }}" tabindex="-1" aria-hidden="true">{% include book-cover.liquid book=book %}</a>
            {%- endif %}
            <div>
              <h3>
                <a href="{{ book.url | relative_url }}">{{ book.title }}</a>
              </h3>
              <p class="book-author">{{ book.author }}</p>
              {% if book.stars %}
                <p class="book-rating">{{ book.stars }} / 5</p>
              {% endif %}
              {% if book.description %}
                <p>{{ book.description }}</p>
              {% endif %}
              <a class="text-link" href="{{ book.url | relative_url }}"
                >Read review<span class="sr-only">: {{ book.title }}</span></a
              >
            </div>
          </article>
        {% endfor %}
      </section>
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">Selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% social_links %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
